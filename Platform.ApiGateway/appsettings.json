{
  "ReverseProxy": {
    "Routes": {
      "aggregator": {
        "ClusterId": "aggregator",
        "Order": 1,
        "Match": { "Path": "/api/aggregator/{**catch-all}" },
        "Metadata": { "Team": "platform", "Version": "v1" }
      },
      "repairs-stock": {
        "ClusterId": "repairs",
        "Order": 5,
        "Match": { "Path": "/api/repairs/catalog-items/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/catalog-items/{**catch-all}" } ],
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "repairs", "Version": "v1" }
      },
      "repair-orders": {
        "ClusterId": "repairs",
        "Order": 10,
        "Match": { "Path": "/api/repair-orders/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "repairs", "Version": "v1" }
      },
      "customers": {
        "ClusterId": "repairs",
        "Order": 10,
        "Match": { "Path": "/api/customers/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "repairs", "Version": "v1" }
      },
      "catalog-items": {
        "ClusterId": "catalog",
        "Order": 10,
        "Match": { "Path": "/api/catalog-items/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "catalog", "Version": "v1" }
      },
      "categories": {
        "ClusterId": "catalog",
        "Order": 10,
        "Match": { "Path": "/api/categories/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "catalog", "Version": "v1" }
      },
      "brands": {
        "ClusterId": "catalog",
        "Order": 10,
        "Match": { "Path": "/api/brands/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "catalog", "Version": "v1" }
      },
      "reviews": {
        "ClusterId": "reviews",
        "Order": 10,
        "Match": { "Path": "/api/reviews/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "reviews", "Version": "v1" }
      }
    },
    "Clusters": {
      "aggregator": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://aggregator" } }
      },
      "repairs": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://repairs-api" } }
      },
      "catalog": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://catalog-api" } }
      },
      "reviews": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://reviews-api" } }
      }
    }
  },
  "AllowedHosts": "*"
}
