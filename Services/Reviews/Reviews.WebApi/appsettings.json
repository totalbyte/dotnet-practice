{
  "Kestrel": {
    "Endpoints": {
      "http": {
        "Url": "http://localhost:5079",
        "Protocols": "Http1"
      },
      "grpc": {
        "Url": "http://localhost:5179"
      }
    }
  },
  "MongoDb": {
    "ConnectionString": "mongodb://127.0.0.1:27017/?maxPoolSize=50&serverSelectionTimeoutMS=5000",
    "DatabaseName": "ReviewsDb"
  },
  "Serilog": {
    "Destructure": [
      { "Name": "ToMaximumDepth", "Args": { "maximumDestructuringDepth": 6 } },
      { "Name": "ToMaximumCollectionCount", "Args": { "maximumCollectionCount": 10 } },
      { "Name": "ToMaximumStringLength", "Args": { "maximumStringLength": 200 } }
    ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/reviews-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
