{
  "Kestrel": {
    "Endpoints": {
      "http": {
        "Url": "http://localhost:5078",
        "Protocols": "Http1"
      },
      "grpc": {
        "Url": "http://localhost:5178"
      }
    }
  },
  "ConnectionStrings": {
    "CatalogDb": "Server=127.0.0.1,1433;Database=CatalogDb;User Id=sa;TrustServerCertificate=True"
  },
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/catalog-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
